# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_PORT=8001
LOG_LEVEL=INFO

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cctb
POSTGRES_PASSWORD=cctb_secret
POSTGRES_DB=cctbv5
DATABASE_URL=postgresql+asyncpg://cctb:cctb_secret@localhost:5432/cctbv5

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OKX Exchange ─────────────────────────────────────────────
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_PAPER_TRADING=true

# ── Discord Alerts ───────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── News APIs ────────────────────────────────────────────────
FINNHUB_TOKEN=
EODHD_TOKEN=

# ── Risk Limits ──────────────────────────────────────────────
MAX_TOTAL_EXPOSURE=0.5
MAX_DAILY_DRAWDOWN=0.03
